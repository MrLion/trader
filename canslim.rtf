            s_i += " " + syminfo.description + " (" + syminfo.ticker + ")" + " " + syminfo.country + "    \uc0\u10020     " + syminfo.sector + " - " + syminfo.industry  + "     \u10020      "\
            s_i += "\uc0\u9893  " + (na(syminfo.employees) ? "-" : str.tostring( syminfo.employees, format.volume)) + "    \u10020     $ "\
                 + str.tostring( totalS*close, format.volume ) + " " + getmcapcat(totalS*close)\
\
        table.cell( cst, startCol+2,  startRow, s_i, 0, 0, tTitleText, bgcolor = tHeaderBkgnd, text_halign = text.align_left, text_size = hdrTextSize )\
\
        COL = startCol\
\
        table.cell( cst, COL,  startRow+1, " \uc0\u9826  ",    0, 0, tHeaderText, bgcolor=tHeaderBkgnd, text_size=cntTextSize )\
        COL += 1\
        COL := addHeaderCell( cst, COL, startRow+1, "Last Quarter YoY", "" )\
\
        tt = "Current Quarterly Earnings.\\nEarnings growth in the most recent quarter.\\nIdeally 25% or more year-over-year."\
        COL := addHeaderCell( cst, COL, startRow+1, "\uc0\u8194 \u8194 \u8194 \u8194 \u8194 \u8194 \u8194 \u8194 C", tt )\
\
        tt := "Annual Earnings Growth.\\nEarnings growth from last year.\\nIdeally 25% or more per year."\
        COL := addHeaderCell( cst, COL, startRow+1, "\uc0\u8194 \u8194 \u8194 \u8194 \u8194 \u8194 \u8194 \u8194 A", tt )\
\
        tt := "New Products, Management, Highs.\\nThe best stocks often have a catalyst that drives growth." +\
              "This could be an innovative product, new leadership, or the stock making new price highs after a consolidation period."\
        COL := addHeaderCell( cst, COL, startRow+1, "New High", tt )\
\
        tt := "Supply and Demand.\\nLook for stocks with relatively small numbers of shares outstanding and increasing trading volume. "+\
              "Smaller float can mean more price appreciation potential."\
        COL := addHeaderCell( cst, COL, startRow+1, "\uc0\u8194 \u8194 S. Float", tt )\
        \
        tt := "Leader or Laggard.\\nBuy the leading stocks in leading industry groups"\
