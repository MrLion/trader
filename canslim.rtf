              "so timing matters significantly."\
        COL := addHeaderCell( cst, COL, startRow+1, "Market Up", tt )\
    \
        if show3Rs\
            tt := "Relative Strength.\\nA measure of how a stock's price performance compares to other stocks or a benchmark index over a specific period. "+\
