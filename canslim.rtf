\
normalizeString( st, len ) =>\
    sl = str.length(st)\
    //str.\
    sp = len-sl\
    spX = ""\
    if sp > 0\
        switch sp\
            1 => spX := " "\
            2 => spX := "  "\
            3 => spX := "   "\
            4 => spX := "    "\
            5 => spX := "     "\
            6 => spX := "      "\
            7 => spX := "       "\
    res = spX+st\
\
createDataBox( left, top, right, bttm, txt, clr ) =>\
    box.new( left, top, right, bottom=bttm, text=txt, text_halign = text.align_right, text_font_family = fontFam,\
             text_valign = text.align_center, text_color = clr, bgcolor = noColor, border_width = boxBorder ) //1, border_color=color.white ) //boxBorder )\
\
var bool allowedView = showAnalyticMode and timeframe.isdaily and showDynamicView and isStock\
