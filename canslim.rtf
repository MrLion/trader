// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
//\
// H I G H _ V O L U M E _ I N D I C A T O R\
//\
// Signals when volume is the Highest positive volume for the last 1 year or ever.\
//\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
var HVE                     = 0\
var float   lastHV1Value    = 0\
var int     lastHV1Bar      = 0\
var float   lastHEValue     = 0\
var int     lastHEBar       = 0\
var         labelHV1        = label.new( na, na, force_overlay=true, color=noColor, textcolor=hviColor, style = label.style_none, tooltip = "Highest Volume TTM" )\
var         labelHVE        = label.new( na, na, force_overlay=true, color=noColor, textcolor=hviColor, style = label.style_none, tooltip = "Highest Volume Ever" )\
\
type        volData\
    float   vol\
    int     barIndex\
var volA                    = array.new<volData>()\
\
if (bar_index > 2 and showHVI)\
    if close[1] >= close[2]\
        newHighVol = false\
        volA.unshift( volData.new(volume[1],bar_index-1) )\
        if volume[1] > lastHV1Value\
            lastHV1Value := volume[1]\
            lastHV1Bar := bar_index-1\
            newHighVol := true\
            labelHV1.set_text( "\uc0\u9734 " ) \
            labelHV1.set_xy( lastHV1Bar, low[1]*0.75 )\
            labelHV1.set_style( label.style_label_up ) \
\
            if lastHV1Value > lastHEValue\
                lastHEValue := lastHV1Value\
                lastHEBar   := lastHV1Bar \
                labelHVE.set_text( "\uc0\u9733 " )\
                labelHVE.set_xy( lastHEBar, low[1]*0.80 )\
                labelHVE.set_style( label.style_label_up ) \
                labelHV1.set_xy( na, na )\
            else if keepOldHVIs\
                labelHV1 := label.new( na, na, force_overlay=true, color=noColor, textcolor=hviColor, style = label.style_none, size = size.normal, tooltip = "Highest Volume TTM" )\
\
        if volA.size() >= yearBars\
            volData lastE = volA.pop()\
            // if we drop last element and bar = lastHV1Bar, we must search for highest in arraay\
            if bar_index - lastHV1Bar > volA.size()-1\
                lastHV1Value := 0\
                for i=0 to volA.size()-1\
                    if volA.get(i).vol > lastHV1Value\
                        lastHV1Value := volA.get(i).vol\
                        lastHV1Bar   := volA.get(i).barIndex\
    else\
        volA.unshift( volData.new(0,0) )\
        if volA.size() >= yearBars\
            volA.pop()\
    \
\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
//\
// T H R E E _ W E E K S _ T I G H T _ I N D I C A T O R\
//\
// Signals with a resistance line when 3 consecutive weeks close between 1.5% from each other.\
// In addition, there are 2 coherence checks:\
// 1) There must not be a high higher than any of the 3 weeks in the previous 12 weeks (downtrend consolidation).\
// 2) Must occur outside of a base as this indicator is a follow up buy opportunity and must occur after a base breakout.\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
hb = ta.highestbars(high,15)\
if timeframe.isweekly and bar_index > 3 and bar_index[3] > lastBaseIndex and show3WT\
    ch1 = (close[1]-close[2]) / close[2] * 100\
    ch2 = (close[2]-close[3]) / close[3] * 100\
\
    TWTs = math.abs(ch1) < 1.5 and math.abs(ch2) < 1.5\
\
    // we look one bar after the fact, so hb needs to be indexed by 1 !\
    if ( TWTs and baseState == dbState.findTop and hb[1]>-3 )\
        y = high[3]\
        if high[1] > high[2] and high[1] > high[3]\
            y := high[1]\
        if high[2] > high[1] and high[2] > high[3]\
            y := high[2]\
        if TWTs\
            line.new( bar_index-3, y, bar_index-1, y, xloc = xloc.bar_index, color=threeWTColor, width=3, force_overlay = true )\
        lastBaseIndex := bar_index\
