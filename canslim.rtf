// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
//\
// Calculate Acc/Dist days for both Stock and Index.\
//\
// If the stock or index is down for the day on volume larger than the prior day\'92s volume and it declines more than 0.2%, it can be counted as a\
// distribution day. Reverse it for accumulation day.\
//\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
type DistDay\
    int   barIndex               = na\
    float barHigh                = na\
\
var distDayA                     = array.new<DistDay>() \
//var preMDistDays\
\
getLastAccDistDays( days ) =>\
    lastAccDays = 0\
    lastDistDays = 0\
    distDayA.clear()\
    varI = isIndex ? 0.002 : 0.01\
    if bar_index > 50\
        for i = 0 to days-1\
            if volume[i] > volume[i+1]\
                if close[i] > close[i+1] and math.abs((close[i]-close[i+1])/close[i+1]) > varI\
                    lastAccDays  += 1\
                else if close[i] < close[i+1] and math.abs((close[i]-close[i+1])/close[i+1]) > varI\
                    lastDistDays += 1\
                    distDayA.unshift( DistDay.new(bar_index[i], high[i]) )\
    [lastAccDays, lastDistDays]\
\
[last21DAccDays,last21DDistDays]    = request.security( syminfo.tickerid, "1D", getLastAccDistDays(21) )\
last21DAccDaysStr                   = str.tostring( last21DAccDays, "#")\
last21DDistDaysStr                  = str.tostring( last21DDistDays, "#")\
\
\
