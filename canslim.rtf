\
const int cx            = 1\
\
var int timeFrom        = analyticsFreq == AnalitycsFreq.stWeekly ? timenow - 365*24*60*60*1000 : timenow - 3*365*24*60*60*1000\
\
\
// Past week updates, the else is to not print the first week.\
if allowedView and (newWEEK or newMONTH)\
\
    if newWEEK\
        pastWeekNum     := newWeekNum\
        pastWeekBoxLeft := newWeekBoxLeft\
        newWeekNum      := weekofyear\
        newWeekBoxLeft  := bar_index\
        prevWI3 := prevWI2\
        prevWI2 := prevWI1\
        prevWI1 := bar_index\
        prevWeekNM := thisWeekNM\
        thisWeekNM := newMONTH\
\
    if newMONTH\
        pastMonthNum    := newMonthNum\
        pastMonthLeft   := NewMonthLeft\
        newMonthNum     := time\
        NewMonthLeft    := newWeekBoxLeft\
        thisWeekNM      := newMONTH\
\
    bl = (analyticsFreq == AnalitycsFreq.stWeekly ? pastWeekBoxLeft : pastMonthLeft)\
    br = bl + (analyticsFreq == AnalitycsFreq.stWeekly ? weekBoxWidth : monthBoxWidth)\
    \
    drawValue = false\
    ab = 0\
    al = 0\
\
    // TEST ON VIC\
    if newWEEK and analyticsFreq == AnalitycsFreq.stWeekly\
        txt = ""\
        if prevWeek == 1\
            txt := " 20\\n" + str.format( " \{0,time,yy\}", time+604800000 )\
            ab := 6\
            al := 1\
        else if prevWeekNM\
            txt := str.format( "\{0,time,MMM\}", time  )\
        else\
            txt := str.format( "\{0,number,#\}", prevWeek  ) \
\
        nzT = normalizeString( txt, nz )\
        if time > timeFrom or isReplay\
            box.new( bl+al-cx, hiDD+ab, br+cx, loDD, text = nzT, text_halign = text.align_right, text_font_family = fontFam, text_valign = text.align_bottom,\
                    text_color = tHeaderText, bgcolor = noColor, text_formatting = text.format_bold, border_width = boxBorder )\
        drawValue := true\
\
    else if newMONTH and analyticsFreq != AnalitycsFreq.stWeekly\
        drawValue := true\
        txt = ""\
        if month(pastMonthNum) == 1\
            txt := str.format( " \{0,time,yyyy\}", pastMonthNum )\
        else if newMONTH\
            txt := str.format( "\{0,time,MMM\}", pastMonthNum )\
\
        nzT = normalizeString( txt, nz )\
        if time > timeFrom or isReplay\
            box.new( bl+al-cx, hiDD+ab, br+cx, loDD, text = nzT, text_halign = text.align_right, text_font_family = fontFam, text_valign = text.align_bottom,\
                    text_color = tHeaderText, bgcolor = noColor, text_formatting = text.format_bold, border_width = boxBorder )\
\
    if newMONTH \
        leftM4  := leftM3\
        leftM3  := leftM2\
        leftM2  := leftM1\
        leftM1  := bl\
        rightM4 := rightM3\
        rightM3 := rightM2\
        rightM2 := rightM1\
        rightM1 := br\
\
    if drawValue and (time > timeFrom or isReplay)\
\
        // Market\
        insertBox( valueM, 50, 30, bl-cx, hiDM, br+cx, loDM )\
        // RS\
        insertBox( lRS1, 80, 50, bl-cx, hiDR, br+cx, loDR )\
        // Performance\
        insertBox( valueTrend, 50, 30, bl-cx, hiDTR, br+cx, loDTR )\
        // Momentum\
        mom = analyticsFreq == AnalitycsFreq.stWeekly ? prevMW : rankMM2\
        insertBox( mom, 3, 1, bl-cx, hiDO, br+cx, loDO )\
        // Acc/Dist\
        diff = last21DAccDays - last21DDistDays\
        txt = str.format( "\{0\}\{1,number,#\}", diff>0?"+":"", diff )\
        nzT = normalizeString( txt, nz )\
        tc  = getValueTextColor(diff,0,-2)\
        createDataBox( bl-cx, hiDAD, br+cx, loDAD, nzT, tc )\
        // Consistency\
        insertBox( growthConsistency, 8, 1, bl-cx, hiDCO, br+cx, loDCO )\
        // Rank\
        bx = insertBox( valueRank, 80, 50, bl-cx, hiDRank, br+cx, loDRank )\
        bx.set_text_formatting( text.format_bold )\
\
// Live Updates\
\
bl = analyticsFreq == AnalitycsFreq.stWeekly ? newWeekBoxLeft : NewMonthLeft\
br = bl + (analyticsFreq == AnalitycsFreq.stWeekly ? weekBoxWidth : monthBoxWidth)\
\
txt = ""\
ab = 0\
al = 0\
\
if bl > 0\
    if analyticsFreq == AnalitycsFreq.stWeekly\
        if weekofyear == 1\
            txt := " 20\\n" + str.format( " \{0,time,yy\}", time+604800000 )\
            ab := 6\
            al := 1\
        else if thisWeekNM\
            txt := str.format( "\{0,time,MMM\}", time  )\
        else\
            txt := str.format( "\{0,number,#\}", weekofyear  ) \
    else \
        if month == 1\
            txt := str.format( " \{0,time,yyyy\}", time )\
        else\
            txt := str.format( "\{0,time,MMM\}", time  )\
\
    nzT = normalizeString( txt, nz )\
    updateBox( cmMonth, bl+al-cx, br+cx, nzT, tHeaderText )\
    cmMonth.set_top( hiDD+ab )\
    // Market\
    txt := na(valueM)  ? "" : str.format( "\{0,number,#\}", valueM )\
    nzT := normalizeString( txt, nz )\
    tc  = getValueTextColor(valueM,30,50)\
    updateBox( cmMarket, bl-cx, br+cx, nzT, tc )\
    labMkt.set_textcolor( tc )\
    // RS\
    txt := na(weeLowestRS) ? "" : str.format( "\{0,number,#\}", weeLowestRS )\
    nzT := normalizeString( txt, nz )\
    tc  := getValueTextColor(weeLowestRS,80,50)\
    updateBox( cmRSBox, bl-cx, br+cx, nzT, tc )\
    labRS.set_textcolor( tc )\
    // Performance\
    txt := na(valueTrend) ? "" : str.format( "\{0,number,#\}", valueTrend )\
    nzT := normalizeString( txt, nz )\
    tc  := getValueTextColor( valueTrend, 50, 30 )\
    updateBox( cmTrend, bl-cx, br+cx, nzT, tc )    \
