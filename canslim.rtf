        // +100% ! Shows magnitude growth from negative quarter to positive quarter \
        // (+30%) Shows growth from any quarter to negative quarter\
        if tableShowHC\
            table.cell( cst, 0,  extDataRow, str.tostring(consecutiveCs), 0, 0, tHeaderText, bgcolor=tValueBkgnd, text_size=cnt2TextSize, text_font_family = valFont,\
                tooltip = "Number of most recent continuous positive EPS quarters. Every 4 quarters, one negative but not counted quarter is allowed. "+\
                "If after a negative quarter, a second or more negative quarter occurs in the next 4 quarters, the count is reset to zero." )\
            itemCount  = array.size(epsQVal)\
            if columns+1 < itemCount\
                prevQ := epsQVal.get(columns+1)\
            consecutiveCs   := 0\
            goodQC := 0\
            for i=1 to columns\
                COL = displayOrder == DisplayOrder.doChronological ? i+1 : columns-i+2\
                valueStr = ""\
                cqIndex := columns-i+1\
                if cqIndex+4 < itemCount\
                    transQ = false\
                    negL = ""\
                    negR = ""\
                    cqnow = epsQVal.get(cqIndex)\
                    cqprv = epsQVal.get(cqIndex+4)\
                    if cqprv < 0 and cqnow > 0 // negative to positive\
                        transQ := true\
                    if cqnow < 0\
                        negL := "("\
                        negR := ")"\
                    cq = (cqnow-cqprv)/math.abs(cqprv)*100\
                    consecutiveCs   := cq > 0 ? consecutiveCs+1 : goodQC > 2 ? consecutiveCs : 0\
                    goodQC := cq > 0 ? goodQC+1: 0\
                    valueStr := na(cq) ? "" :\
                      str.format( "\{0\}\{3\}\{1\}\{2,number,#\}\{4\}", tableShowQN ? str.tostring(cqnow,"#.###")+"\\n" : "",  cq > 0 ? "+" : "", cq, negL, negR )\
                    //tc := cq > 0 ? color.white : #ffd966\
                    tc := transQ ? valueColorT : cq > 0 ? valColorOK : valColorKO\
                table.cell( cst, COL, extDataRow, text=valueStr, bgcolor = tValueBkgnd, text_color = tc, text_size = tableShowQN?cnt2TextSize:cnt2TextSize,\
                            text_font_family = valFont, text_halign = text.align_right )\
            extDataRow += 1\
\
        // Revenue\
        if tableShowHS\
            table.cell( cst, 0,  extDataRow, str.tostring(consecutiveRevs),    0, 0, tHeaderText, bgcolor=tValueBkgnd, text_size=cnt2TextSize, text_font_family = valFont,\
                tooltip = "Number of most recent continuous positive Revenue quarters. Every 4 quarters, one negative but not counted quarter is allowed. "+\
                "If after a negative quarter, a second or more negative quarter occurs in the next 4 quarters, the count is reset to zero." )\
            itemCount  = revQG.size()\
            consecutiveRevs := 0\
            goodQR := 0\
            for i=1 to columns\
                COL = displayOrder == DisplayOrder.doChronological ? i+1 : columns-i+2\
                valueStr = ""\
                cqIndex := columns-i+1\
                if cqIndex < itemCount\
                    cq = revQ.get(cqIndex)\
                    prog = revQG.get(cqIndex)\
                    revEst = revEstQ.get(cqIndex)\
                    valueStr := na(prog) ? "" : str.format( "\{0\}\{1\}\{2,number,#\}", tableShowQN?str.tostring(cq,format.volume)+"\\n":"", prog>0?"+":"", prog )\
                    prevQ := cq\
                    //tc := prog > 0 ? color.white : #ffd966\
                    tc := prog > 0 ? valColorOK : valColorKO\
                    consecutiveRevs := prog > 0 ? consecutiveRevs+1 : goodQR>2 ? consecutiveRevs : 0\
                    goodQR := prog > 0 ? goodQR+1: 0\
                table.cell( cst, COL, extDataRow, text=valueStr, bgcolor = tValueBkgnd, text_color = tc, text_size = tableShowQN?cnt2TextSize:cnt2TextSize,\
                            text_font_family = valFont, text_halign = text.align_right )\
            extDataRow += 1\
\
        // Return On Equity\
        if tableShowHR\
            table.cell( cst, 0,  extDataRow, str.tostring(consecutiveRoes), 0, 0, tHeaderText, bgcolor=tValueBkgnd, text_size=cnt2TextSize, text_font_family = valFont,\
                tooltip = "Number of most recent continuous positive ROE quarters. Every 4 quarters, one negative but not counted quarter is allowed. "+\
                "If after a negative quarter, a second or more negative quarter occurs in the next 4 quarters, the count is reset to zero." )\
            itemCount  = array.size(roeY)\
            consecutiveRoes := 0\
            goodQO := 0\
            for i=1 to columns\
                COL = displayOrder == DisplayOrder.doChronological ? i+1 : columns-i+2\
                valueStr = ""\
                cqIndex := columns-i+1\
                if cqIndex < itemCount\
                    cq = roeY.get(cqIndex) //11\
                    if cq == prevQ\
                        valueStr := "-"\
                    else\
                        valueStr := na(cq) ? "" : str.format( "\{0\}\{1,number,#\}", cq>0?"+":"", cq )\
                    prevQ := cq\
                    //tc := cq > 0 ? color.white : #ffd966\
                    tc := cq > 0 ? valColorOK : valColorKO\
                    consecutiveRoes := cq > 0 ? consecutiveRoes+1 : goodQO>2 ? consecutiveRoes : 0\
                    goodQO := cq > 0 ? goodQO+1: 0\
                table.cell( cst, COL, extDataRow, text=valueStr, bgcolor = tValueBkgnd, text_color = tc, text_size = cnt2TextSize, text_font_family = valFont,\
                            text_halign = text.align_right )\
            extDataRow += 1\
\
        // Annual Earnings\
        if tableShowHA\
            table.cell( cst, 0,  extDataRow, "   ",    0, 0, tHeaderText, bgcolor=tValueBkgnd, text_size=cnt2TextSize, text_font_family = valFont )\
            itemCount  = array.size(epsY)\
            for i=1 to columns\
                COL = displayOrder == DisplayOrder.doChronological ? i+1 : columns-i+2\
                valueStr = ""\
                cqIndex := columns-i+1\
                if cqIndex < itemCount\
                    cq = epsY.get(cqIndex)\
                    cqVal = epsYVal.get(cqIndex)\
                    if cq == prevQ\
                        valueStr := "" // Annual earnings are the same till next annual report\
                    else\
                        if cqVal > 0\
                            valueStr := na(cq) ? "" : str.format( "\{0\}\{1\}\{2,number,#\}", tableShowQN ? str.tostring(cqVal,"#.###")+"\\n" : "", cq>0?"+":"", cq )\
                        else\
                            valueStr := na(cq) ? "" : str.format( "\{0\}(\{1\}\{2,number,#\})", tableShowQN ? str.tostring(cqVal,"#.###")+"\\n" : "", cq>0?"+":"", cq )\
                    prevQ := cq\
                    //tc := cq > 0 ? color.white : #ffd966\
                    tc := cq > 0 ? valColorOK : valColorKO\
                table.cell( cst, COL, extDataRow, text=valueStr, bgcolor = tValueBkgnd, text_color = tc, text_size = cnt2TextSize, text_font_family = valFont,\
                            text_halign = text.align_right )\
            extDataRow += 1\
\
        // End of historical data\
\
\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
//\
// P O C K E T _ P I V O T S \
// \
// Pocket pivots are according to the current time frame.\
// Volume on the pocket pivot day has to be greater than the highest low day volume in the prev period days..\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
PPlen                       = 10 \
UpDay                       = close > open and close[0] > close[1]\
var lastPPIndex             = 0\
max_bars_back(volume, 100)\
// CALCULATE \
// Length days - default is 10.  PPvol1 must count up to PPlen\
PPvol1 = 0\
if bar_index > 100\
    if UpDay and bar_index-lastPPIndex > 9\
        for i = 1 to 50 //search down days on last 50 days...\
            dday = close[i] < close[i+1] \
            if dday\
                if volume[0] > volume[i]\
                    PPvol1 += 1\
                    if PPvol1 == PPlen\
                        break\
                else\
                    break\
\
// Pocket pivot is shown if precedent one is at least 10 days old to avoid repetition \
PocketPivot  = PPvol1 == PPlen and showPocketPivots\
lastPPIndex := PocketPivot ? bar_index : lastPPIndex\
\
// DISPLAY\
if PocketPivot \
    label.new( bar_index, low, "\uc0\u9652 ", xloc = xloc.bar_index, yloc = yloc.belowbar, style = label.style_none, color=noColor, textcolor = color.yellow, tooltip = "Pocket Pivot",\
               force_overlay = true )\
\
\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
//\
// B A S E S _ I N D I C A T O R _ ( D A R V A S _ B O X E S ) \
//\
// According to Darvas Boxes description, we find a top when there are basePeriod bars under the recent high (consolidation).\
// Once the top is found we look for the bottom in the same but contrary manner.\
// If a top is violated on a closing basis before the bottom is completed, it becomes a partial base (but still shown as normal base).\
// When the base is violated on a closing basis or reaches its maximum bars, we stop drawing and look for a new base.\
//\
// Base Counting Rules.\
// The base stage and count are always reset to 1 once an intraday low price undercuts the low of a previous base.\
// Base-on-Base Pattern and 20% Rule:\
// Each base should form at least 20% above the buy point of the base that preceded it, Here I use the 75% level from the low of the base as buy point.\
// If the advance is less than 20% and the stock builds another base, it's a base-on-base pattern and it's counted as an extension of the previous base.\
//\
// Base on base violations don't reset the base count !\
//\
// According to William O'Neil's teachings and the principles of CANSLIM, if a stock forms a base on a prior base, and the prior base is not violated,\
// the new base is considered a continuation of the previous one. The new base is labeled with a "a", "b", "c", etc base of the same base number.\
//\
// However, the base count does reset to a new "first-stage" base if there is a violation of the prior base. A violation is defined as the stock's price dropping\
// and undercutting the low of the previous main base. This is a crucial distinction.\
//\
// The "base on base" pattern is only considered a valid continuation if the stock remains above the low of the previous base.\
//\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
enum dbState\
    idle                        = "Idle"\
    init                        = "init"\
    findTop                     = "findTop"\
    findBottom                  = "findBottom"\
    basePartial                 = "basePartial"\
    baseComplete                = "baseComplete"\
    waitBreak                   = "WaitBreak"\
    countPartial                = "countPartial"\
    countComplete               = "countComplete"\
\
var float   darvasTop           = na\
var int     darvasLeft          = 0\
var int     darvasRight         = 0\
var float   darvasBottom        = na\
var float   darvasMid           = na\
var float   darvasPivot         = na\
var int     daysCountTop        = 0\
var int     daysCountBottom     = 0\
var int     darvasBottomLeft    = 0\
var         lineLastTop         = line.new( na, na, na, na, color=partialBaseColor, width=1, force_overlay = true, style = line.style_dotted )\
var         lineLastBottom      = line.new( na, na, na, na, color=partialBaseColor, width=1, force_overlay = true, style = line.style_dotted )\
var         lineLastMiddle      = line.new( na, na, na, na, color=showHalfBase?halfBaseColor:noColor, width=1, force_overlay = true, style = line.style_dashed )\
yr                              = yearsBack\
start                           = timestamp( yearNow-yr, monthNow, dayNow, 0, 0 )\
var dbState baseState           = dbState.idle\
var int     lastBaseIndex       = 0\
var initCount                   = 0\
var highestPt                   = 0.0\
var lowestPt                    = 0.0\
var highestPtPos                = 0\
var lowestPtPos                 = 0\
var float currentBaseTop        = na\
var float currentBaseBottom     = na\
var int   currentBaseRight      = na\
var dLeft                       = 0\
var int breakBar                = na\
var float prevBaseTop           = 0\
var float prevBasePivot         = 0\
var float prevBaseBottom        = 0\
var bool baseOnBase             = false\
var float lastBaseTopAny        = 0\
var float lastBaseBottomAny     = 0\
var int   lastBaseLeftAny       = 0\
basePeriod                      = timeframe.isweekly ? basePeriodW : basePeriodD\
var line darvasTopLine          = na\
var line darvasBottomLine       = na\
\
var darvasMaxVol                = 0.0\
var int darvasLowIndex          = na\
\
if not showBases\
    completeBaseColor := noColor\
    partialBaseColor  := noColor\
    halfBaseColor     := noColor\
\
// wait start time\
if time >= start and baseState == dbState.idle\
    // Don't go to init the very first time !\
    baseState := dbState.findTop\
    // fall-through state, process on the same tick\
\
dHigh   = high \
dLow    = low \
dLeft  := bar_index \
dHigh1  = high \
dLow1   = low \
\
if baseState != dbState.idle\
\
    if baseState == dbState.init\
        // Set first high on the bar that broke previous base\
        iLeft = dLeft\
        iHigh = dHigh\
        iLow  = dLow\
        if not na(breakBar)\
            iLeft    := breakBar\
            index    = bar_index - iLeft\
            iLow     := low[index]\
            iHigh    := high[index]\
            breakBar := na\
        darvasTop           := iHigh \
        daysCountTop        := 0\
        darvasLeft          := iLeft\
        darvasBottomLeft    := iLeft\
        darvasBottom        := iLow\
        // check bar 1\
        if high[1] > darvasTop\
            darvasTop        := high[1]\
            darvasLeft       := bar_index-1\
            darvasBottomLeft := darvasLeft\
        if low[1] < darvasBottom\
            darvasBottom := low[1]\
            darvasBottomLeft := bar_index-1\
\
        darvasMid           := darvasBottom+(darvasTop-darvasBottom)/2\
        darvasPivot         := darvasBottom+(darvasTop-darvasBottom)*0.75\
        daysCountBottom     := 0\
        darvasRight         := iLeft\
        baseState           := dbState.findTop\
        highestPt           := darvasTop\
        lowestPt            := darvasBottom\
        baseOnBase          := false\
        darvasMaxVol        := 0\
        darvasLowIndex      := na\
    else\
        darvasMaxVol := volume > darvasMaxVol ? volume : darvasMaxVol\
\
\
    // Looking for a top...\
    // No else\
    if baseState == dbState.findTop\
        if na(darvasTop) or dHigh > darvasTop\
            darvasTop        := dHigh1\
            darvasLeft       := dLeft\
            darvasBottom     := dLow\
            darvasMid        := darvasBottom+(darvasTop-darvasBottom)/2\
            darvasPivot      := darvasBottom+(darvasTop-darvasBottom)*0.75\
            darvasBottomLeft := dLeft\
            currentBaseTop   := darvasTop\
            //darvasVolTop     := volume\
\
        daysCountTop := dLeft-darvasLeft\
        \
        if na(darvasBottom) or dLow < darvasBottom\
            darvasBottom     := dLow1\
            darvasMid        := darvasBottom+(darvasTop-darvasBottom)/2\
            darvasPivot      := darvasBottom+(darvasTop-darvasBottom)*0.75\
            darvasBottomLeft := dLeft\
            currentBaseBottom   := darvasBottom\
            rng = (darvasTop-darvasBottom)/darvasTop*100\
            if rng > 80\
                darvasTop := na // reset\
 \
        daysCountBottom := dLeft - darvasBottomLeft\
        darvasRight := dLeft\
\
        if daysCountBottom == basePeriod\
            baseState := dbState.waitBreak //dbState.baseComplete\
            lineLastTop.set_style( line.style_solid )\
            lineLastBottom.set_style( line.style_solid )\
            lastBaseTopAny := na\
            lastBaseBottomAny := na\
            //darvasVolTop := volume[bar_index-darvasLeft]\
        else if daysCountTop == basePeriod\
            baseState := dbState.findBottom\
            lastBaseIndex := dLeft\
            lineLastTop.set_style( line.style_solid )\
            lastBaseTopAny := na\
            lastBaseBottomAny := na\
            //darvasVolTop := volume[bar_index-darvasLeft]\
        else\
            lineLastTop.set_style( line.style_dotted )\
            lineLastBottom.set_style( line.style_dotted )\
\
\
        // display base on base or not\
        adv  = prevBaseTop > 0 ? (darvasTop-prevBaseTop)/prevBaseTop*100 : 0\
        baseOnBase := darvasTop>prevBaseTop and adv < 20 \
\
        if daysCountTop == basePeriod\
            if baseOnBase\
                lineLastTop.set_color( halfBaseColor )\
            else\
                lineLastTop.set_color( completeBaseColor )\
        else\
            lineLastTop.set_color( partialBaseColor )\
\
        if daysCountBottom == basePeriod\
            if baseOnBase\
                lineLastTop.set_color( halfBaseColor )\
                lineLastBottom.set_color( halfBaseColor )\
            else\
                lineLastTop.set_color( completeBaseColor )\
                lineLastBottom.set_color( completeBaseColor )\
        else\
            lineLastBottom.set_color( partialBaseColor )\
\
\
        lineLastTop.set_xy1( darvasLeft, darvasTop )\
        lineLastTop.set_xy2( darvasRight, darvasTop )\
\
        lineLastBottom.set_xy1( darvasLeft, darvasBottom )\
        lineLastBottom.set_xy2( darvasRight, darvasBottom )\
\
        lineLastMiddle.set_xy1( darvasLeft, darvasMid )\
        lineLastMiddle.set_xy2( darvasRight, darvasMid )\
        \
    // We have found a top, Looking for a bottom...\
    // No else\
    if baseState == dbState.findBottom\
        lastBaseIndex := dLeft\
\
        if na(darvasBottom) or dLow < darvasBottom\
            darvasBottom    := dLow1\
            darvasMid       := darvasBottom+(darvasTop-darvasBottom)/2\
            darvasPivot     := darvasBottom+(darvasTop-darvasBottom)*0.75\
            //daysCountBottom := -1\
            darvasBottomLeft := dLeft\
            currentBaseBottom   := darvasBottom\
        \
        daysCountBottom := dLeft - darvasBottomLeft\
\
        darvasRight := dLeft\
\
        if close[1] > darvasTop\
            baseState := dbState.basePartial\
            darvasRight -= 1\
            lineLastBottom.set_style( line.style_solid )\
            breakBar := dLeft-1\
            currentBaseTop := darvasTop\
            currentBaseRight := dLeft-1 \
        \
        else if daysCountBottom == basePeriod\
            baseState := dbState.waitBreak\
            lineLastBottom.set_style( line.style_solid )\
\
        if daysCountBottom == basePeriod\
            if baseOnBase\
                //lineLastTop.set_color( halfBaseColor )\
                lineLastBottom.set_color( halfBaseColor )\
            else\
                // lineLastTop.set_color( completeBaseColor )\
                lineLastBottom.set_color( completeBaseColor )\
        else\
            lineLastBottom.set_color( partialBaseColor )\
\
        lineLastTop.set_style( line.style_solid )\
        lineLastTop.set_xy1( darvasLeft,     darvasTop )\
        lineLastTop.set_xy2( darvasRight,    darvasTop )\
        lineLastBottom.set_xy1( darvasLeft,     darvasBottom )\
        lineLastBottom.set_xy2( darvasRight,    darvasBottom )\
\
        middle = darvasBottom+(darvasTop-darvasBottom)/2\
        lineLastMiddle.set_xy1( darvasLeft, middle )\
        lineLastMiddle.set_xy2( darvasRight, middle )\
\
    // Top and bottom found, looking for a break...\
    // No else \
    if baseState == dbState.waitBreak\
        //log.info( "NEW BAR \{0\} waitBreak", bar_index )\
        if( close[1] > darvasTop  or close[1] < darvasBottom or bar_index-darvasLeft >= maxBars )\
            baseState := dbState.baseComplete\
            breakBar := dLeft-1\
            //log.info( "BASE COMPLETE at time \{0\} with \{1\}/\{2\} bars",\
            currentBaseTop := darvasTop\
            currentBaseRight := dLeft-1 \
            darvasLowIndex := na\
\
        darvasRight := dLeft-1\
        //currentBaseRight := darvasRight\
        if baseOnBase\
            lineLastTop.set_color( halfBaseColor )\
            lineLastBottom.set_color( halfBaseColor )\
        else\
            lineLastTop.set_color( completeBaseColor )\
            lineLastBottom.set_color( completeBaseColor )\
\
        lineLastTop.set_xy1( darvasLeft,     darvasTop )\
        lineLastTop.set_xy2( darvasRight,    darvasTop )\
        lineLastBottom.set_xy1( darvasLeft,     darvasBottom )\
        lineLastBottom.set_xy2( darvasRight,    darvasBottom )\
\
        middle = darvasBottom+(darvasTop-darvasBottom)/2\
        lineLastMiddle.set_xy1( darvasLeft, middle )\
        lineLastMiddle.set_xy2( darvasRight, middle )\
\
    // When we have either a partial or complete base we can draw it and give the processor to the counter \
    // No else !\
    if baseState == dbState.basePartial or baseState == dbState.baseComplete\
        //log.info( "NEW BAR \{0\} \{1\}", bar_index, str.tostring(baseState) )\
        currentBaseTop      := darvasTop\
        currentBaseBottom   := darvasBottom\
        lastBaseTopAny      := darvasTop\
        lastBaseBottomAny   := darvasBottom\
        lastBaseLeftAny     := darvasLeft\
\
        if darvasTop > prevBaseTop and darvasBottom < prevBaseBottom\
            baseOnBase := false\
        lC = baseOnBase ? halfBaseColor : completeBaseColor\
        // Draw final base lines \
        darvasTopLine    := line.new( darvasLeft, darvasTop,    darvasRight, darvasTop,     color = lC, width = 1, force_overlay = true )\
        darvasBottomLine := line.new( darvasLeft, darvasBottom, darvasRight, darvasBottom,  color = lC, width = 1, force_overlay = true )\
        if showBases and showHalfBase\
            line.new( darvasLeft, darvasMid, darvasRight, darvasMid, color=showHalfBase?halfBaseColor:noColor, width=1, force_overlay = true, style = line.style_dashed )\
            line.new( darvasRight-1, darvasPivot, darvasRight, darvasPivot, color=showHalfBase?halfBaseColor:noColor, width=1, force_overlay = true, style = line.style_solid )\
\
        baseState := baseState == dbState.basePartial ? dbState.countPartial : dbState.countComplete\
\
\
// Keep trace of current/last base info\
//baseLastLeft     = na(lastBaseLeftAny) ? darvasLeft : lastBaseLeftAny \
baseLastLeft     = na(darvasLeft) ? lastBaseLeftAny : darvasLeft\
baseLastTop      = na(lastBaseTopAny) ? darvasTop : lastBaseTopAny \
baseLastBottom   = na(lastBaseBottomAny) ? darvasBottom : lastBaseBottomAny\
\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
// counter Logic\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
const int BASE_NONE             = 0\
const int BASE_FIRST            = 1\
const int BASE_HIGH             = 2\
const int BASE_HIGH_RESET       = 3\
const int BASE_HIGH_BOB         = 4\
const int BASE_HIGH_BOB_RESET   = 5\
const int BASE_LOW              = 6\
const int BASE_LOW_RESET        = 7\
var baseTypes                   = array.from( "BASE_NONE", "BASE_FIRST", "BASE_HIGH", "BASE_HIGH_RESET", "BASE_HIGH_BOB", "BASE_HIGH_BOB_RESET", "BASE_LOW", "BASE_LOW_RESET" )\
var baseAbb                     = array.from( " N"," F", " H", " HR", " B", " BR", " L", " LR" ) // debug only\
varip lastBaseCntIndex          = 0\
var bool cntReset               = false\
var bobLetter                   = array.from( 'a','b','c','d','e','f','g','h','i','j','k','l','m','n','o','p','q','r','s','t','u','v','w','x','y','z')\
var int bobIndex                = 0\
var higherThanCB                = false\
var lowerThanCB                 = false\
var higherThanPB                = false\
var lowerThanPB                 = false\
var lastBoBTop                  = 0.0\
var baseIncrease                = 0.0\
var lastBaseLabel               = 0\
var phigherThanCB               = false\
var plowerThanCB                = false\
var phigherThanPB               = false\
var plowerThanPB                = false\
var resetDone                   = false\
var label lTempMove             = label.new( na, na, "", force_overlay=true, color=noColor, style=label.style_text_outline, textcolor=completeBaseColor, textalign = text.align_left )\
var box   lTempBaseBoxName      = box.new( na, na, na, 1, force_overlay=true, bgcolor=na, text_halign=text.align_left, text_valign = text.align_bottom, text_size = 12,\
                                           border_color = noColor, border_width=0 )\
var lTempVisible                = false\
var baseType                    = BASE_NONE\
var lastNonBBBottom             = 0.0\
var lastBaseNumber              = 0\
\
type Base\
    string mName\
    int    mNr                  = na\
    int    mLeft                = na\
    float  mTop                 = na\
    int    mRight               = na\
    float  mBottom              = na\
    float  mAbsBottom           = na // outside base\
    float  mPivotPoint          = na\
    float  mMidPoint            = na\
\
method copyBase( Base this, Base from ) =>\
    this.mName       := from.mName\
    this.mNr         := from.mNr\
    this.mLeft       := from.mLeft\
    this.mTop        := from.mTop\
    this.mRight      := from.mRight\
    this.mBottom     := from.mBottom\
    this.mAbsBottom  := from.mAbsBottom\
    this.mPivotPoint := from.mPivotPoint\
    this.mMidPoint   := from.mMidPoint\
\
method reset( Base this ) =>\
    this.mName                  := na\
    this.mNr                    := na\
    this.mLeft                  := na\
    this.mTop                   := na\
    this.mRight                 := na\
    this.mBottom                := na\
    this.mAbsBottom             := na\
    this.mPivotPoint            := na\
    this.mMidPoint              := na\
\
var cntCurrBase                 = Base.new( mBottom = na, mTop = na )\
var cntPrevBase                 = Base.new( mBottom = 0 )\
\
atrdp = ta.atr(25) / close * 100\
\
// ISSUES:\
// Important things to know before determining which kind of base we have...\
// These below must be processed in the correct given order !\
// 1. Update current base absolute bottom if there is a lower price while looking for a new top.\
if baseState == dbState.countPartial or baseState == dbState.countComplete or baseState == dbState.findTop\
    if not na(cntCurrBase.mBottom) and low[1] < cntCurrBase.mAbsBottom and not higherThanCB\
        cntCurrBase.mAbsBottom := low[1]\
        //log.info( "Base \{0\} has an abs bottom of \{1\}", cntCurrBase.mName, cntCurrBase.mAbsBottom)\
\
// 2. Check if price travelled above the curent base. >>>>>>>> Means that we already were above Base so higherThanCB = true\
if not na(cntCurrBase.mTop) and darvasTop > cntCurrBase.mTop and (baseState == dbState.findBottom or baseState==dbState.findTop)\
    higherThanCB := true\
\
// 3. Check if price travelled below the curent base.\
// Here we test the absolute bottom of the base, not darvasBottom !\
if not na(cntCurrBase.mBottom) and darvasBottom < cntCurrBase.mAbsBottom and higherThanCB and baseState == dbState.findBottom\
    // calc percent\
    px = (cntCurrBase.mAbsBottom-darvasBottom)/cntCurrBase.mAbsBottom*100\
    if px > 0.5*atrdp\
        lowerThanCB := true\
\
// 4. Check if price travelled above the previous base.\
if not na(cntPrevBase.mTop) and darvasTop > cntPrevBase.mTop\
    higherThanPB := true\
\
// 5. Check if price travelled below the previous base.\
if low < cntPrevBase.mBottom\
    // calc percent\
    px = (cntPrevBase.mBottom-low)/cntPrevBase.mBottom*100\
    if px > 0.5*atrdp\
        lowerThanPB := true\
\
if high > highestPt\
    highestPt       := high\
    highestPtPos    := bar_index\
if low < lowestPt\
    lowestPt        := low\
    lowestPtPos     := bar_index\
\
// Counting logic...\
if baseState == dbState.countPartial or baseState == dbState.countComplete\
    baseType   := BASE_NONE\
    baseName    = ""\
    yearReset   = false\
    addIncrease = false\
\
    // Determine which base we are in.\
    if na(cntCurrBase.mNr) \
        baseType := BASE_FIRST\
    // new base above prev\
    else if darvasTop > cntCurrBase.mTop\
        priorLevel = cntCurrBase.mTop \
        baseIncrease := (darvasTop-priorLevel)/priorLevel*100\
        topInc = (darvasTop-cntCurrBase.mTop)/cntCurrBase.mTop*100\
        baseInc = 20.0\
        if not isStock\
            baseInc := atrdp * 2\
        if baseIncrease > baseInc //and topInc > baseInc// Went more than 10/20%\
            // If price went lower than current base low, we must reset.\
            baseType := (lowerThanCB or lowerThanPB) ? BASE_HIGH_RESET : BASE_HIGH\
            bobIndex := 0\
        else \
            // bases on bases can also reset the counter if they travel below the low of previous base.\
            baseType :=  (lowerThanCB or lowerThanPB) ? BASE_HIGH_BOB_RESET : BASE_HIGH_BOB\
    // new base below prev\
    else if darvasTop < cntCurrBase.mTop\
        // Lower than current or previous will reset.\
        baseType := (lowerThanCB or lowerThanPB) ? BASE_LOW_RESET : BASE_LOW\
\
    if baseType == BASE_HIGH_RESET or baseType == BASE_HIGH or baseType == BASE_LOW_RESET\
        lastBoBTop  := 0.0\
        bobIndex    := 0\
\
    // Custom addon as it makes no sense to keep bases longer than a year...\
    // Base reset count if HIGHER base lasts longer than a year\
    if not na(cntCurrBase.mLeft) and bar_index-cntCurrBase.mLeft > yearBars and darvasTop < cntCurrBase.mTop\
        baseType := BASE_LOW_RESET\
        yearReset := true\
        bobIndex := 0\
        \
    if baseType != BASE_HIGH_BOB and baseType != BASE_HIGH_BOB_RESET\
        lastNonBBBottom := darvasBottom\
\
\
    // Deal with the different bases types \
    if baseType == BASE_FIRST\
        //log.info( "BASE_FIRST" )\
        cntCurrBase.mNr         := 1\
        cntCurrBase.mLeft       := darvasLeft\
        cntCurrBase.mTop        := darvasTop\
        cntCurrBase.mRight      := darvasRight\
        cntCurrBase.mBottom     := darvasBottom\
        cntCurrBase.mAbsBottom  := darvasBottom\
        cntCurrBase.mPivotPoint := darvasPivot\
        cntCurrBase.mMidPoint   := darvasMid\
        baseName                := str.tostring(cntCurrBase.mNr)\
        cntCurrBase.mName       := baseName\
        cntReset                := false\
        bobIndex                := 0\
\
    else if baseType == BASE_HIGH\
        //log.info( "BASE_HIGH \{0\}", cntCurrBase.mNr+1 )\
        cntPrevBase.copyBase( cntCurrBase )\
        cntCurrBase.mNr         += 1\
        cntCurrBase.mLeft       := darvasLeft\
        cntCurrBase.mTop        := darvasTop\
        cntCurrBase.mRight      := darvasRight\
        cntCurrBase.mBottom     := darvasBottom\
        cntCurrBase.mAbsBottom  := darvasBottom\
        cntCurrBase.mPivotPoint := darvasPivot\
        cntCurrBase.mMidPoint   := darvasMid\
        baseName                := str.tostring(cntCurrBase.mNr)\
        cntCurrBase.mName       := baseName\
        cntReset                := false\
        bobIndex                := 0\
        higherThanCB            := false\
        lowerThanCB             := false\
        if showBaseIncCorr\
            addIncrease := true\
\
    else if baseType == BASE_HIGH_RESET or baseType == BASE_HIGH_BOB_RESET\
        cntReset := true\
\
        if showBaseIncCorr and baseType == BASE_HIGH_RESET\
            addIncrease := true\
        if baseType == BASE_HIGH_BOB_RESET\
            lastBoBTop := darvasTop\
\
    else if baseType == BASE_HIGH_BOB\
        //log.info( "BASE_HIGH_BOB" )\
        if darvasTop > lastBoBTop \
            baseName := str.format( "\{0\}\{1\}", cntCurrBase.mNr, bobLetter.get(bobIndex) )\
            if bobIndex < 25\
                bobIndex += 1\
            lastBoBTop := darvasTop\
        else \
            custIndex = bobIndex > 0 ? bobIndex-1 : bobIndex\
            baseName := str.format( "\{0\}\{1\}", cntCurrBase.mNr, bobLetter.get(custIndex) )\
        // update current base bottom !\
        if darvasBottom < cntCurrBase.mBottom \
            cntCurrBase.mBottom := darvasBottom \
            cntCurrBase.mPivotPoint := darvasPivot\
            cntCurrBase.mMidPoint   := darvasMid\
        cntReset := false\
\
    else if baseType == BASE_LOW\
        if darvasBottom < cntCurrBase.mBottom\
            cntCurrBase.mBottom := darvasBottom\
        if darvasBottom < cntCurrBase.mAbsBottom\
            cntCurrBase.mAbsBottom := darvasBottom\
        rn = (cntCurrBase.mTop-cntCurrBase.mAbsBottom)/currentBaseTop*100\
        if rn > 50\
            cntReset := true\
        baseName := str.tostring(cntCurrBase.mNr)\
\
    else if baseType == BASE_LOW_RESET\
        cntReset:= true\
\
    // \uc0\u10019  \u10019  \u10019  No more base types \u10019  \u10019  \u10019 \
    // Custom Reset if below MA200\
    if darvasBottom < ma200\
        cntReset := true\
\
    if cntReset \
        cntPrevBase.reset()\
        cntCurrBase.mNr         := 1\
        cntCurrBase.mLeft       := darvasLeft\
        cntCurrBase.mTop        := darvasTop\
        cntCurrBase.mRight      := darvasRight\
        cntCurrBase.mBottom     := darvasBottom\
        cntCurrBase.mAbsBottom  := darvasBottom\
        cntCurrBase.mPivotPoint := darvasPivot\
        cntCurrBase.mMidPoint   := darvasMid\
        higherThanCB            := false\
        lowerThanCB             := false\
        higherThanPB            := false\
        lowerThanPB             := false\
        baseName                := str.tostring(cntCurrBase.mNr)\
        cntCurrBase.mName       := baseName\
        lastBoBTop              := 0\
        bobIndex                := 0\
\
    // Labelize...\
    if showBases and showBaseCount\
        lTempMove.set_xy( na, na )\
        lTempMove.set_text( "" )\
        lTempBaseBoxName.set_lefttop(na,na)\
        lTempVisible := false\
\
        lastBaseLabel := darvasLeft\
        if yearReset\
            baseName +="Y"\
        if cntReset\
            baseName +="R"\
        if addIncrease\
            baseName += str.format("\uc0\u10138 \{0,number,#\}%", baseIncrease )\
        if showBaseIncCorr and baseType != BASE_HIGH_BOB\
            corrN = (darvasTop-darvasBottom)/darvasTop*100\
            baseName += str.format("\uc0\u11021 \{0,number,#\}%", corrN )\
        labColor = completeBaseColor\
        if cntReset\
            darvasTopLine.set_color( completeBaseColor )\
            darvasBottomLine.set_color( completeBaseColor )\
        else if baseType == BASE_HIGH_BOB\
            darvasTopLine.set_color( halfBaseColor )\
            darvasBottomLine.set_color( halfBaseColor )\
            labColor := halfBaseColor\
        else\
            darvasTopLine.set_color( completeBaseColor )\
            darvasBottomLine.set_color( completeBaseColor )\
        box.new( darvasLeft, darvasTop*1.01, darvasLeft+5, darvasTop, text=baseName, text_color=labColor, force_overlay=true, bgcolor=na, text_halign=text.align_left,\
                 text_valign = text.align_bottom, text_size = 12, border_color = noColor, text_font_family= font.family_default, border_width=0 )\
        if baseType != BASE_HIGH_BOB\
            prevBaseTop := darvasTop\
            prevBasePivot := darvasPivot\
            prevBaseBottom := darvasBottom\
\
    // \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
    //  Base Counted, give the processor back to darvas state machine.\
    if baseState == dbState.countPartial or baseState == dbState.countComplete\
        baseState := dbState.init\
\
varip prevState = dbState.idle\
if baseState != prevState\
    //log.info( "Base State changed from \{0\} to \{1\}", str.tostring(prevState), str.tostring(baseState) )\
    prevState := baseState\
\
// Set temporary Label when Top is complete\
if (baseState == dbState.findBottom or baseState == dbState.waitBreak) and showBases and daysCountBottom > 0\
    if not lTempVisible\
        priorLevel      = cntCurrBase.mTop //PivotPoint\
        baseIncrease   := (darvasTop-priorLevel)/priorLevel*100\
        baseName        = ""\
        baseInc = isIndex ? 10 : 20\
        //lastBaseLeft := darvasLeft\
        if baseIncrease > baseInc\
            baseName := str.format("\{0\}", cntCurrBase.mNr+1)\
            lastBaseNumber := cntCurrBase.mNr+1\
        else if baseIncrease > 0 \
            baseName := str.format( "\{0\}\{1\}", cntCurrBase.mNr, bobLetter.get(bobIndex) )\
            lastBaseNumber := cntCurrBase.mNr\
        else\
            baseName := str.format("\{0\}", cntCurrBase.mNr)\
            lastBaseNumber := cntCurrBase.mNr\
        if showBaseIncCorr\
            baseName += str.format("\uc0\u10138 \{0,number,#\}%", baseIncrease )\
\
        lTempBaseBoxName.set_left(darvasLeft)\
        lTempBaseBoxName.set_top(darvasTop+0.1)\
        lTempBaseBoxName.set_right(darvasLeft+5)\
        lTempBaseBoxName.set_bottom(darvasTop)\
        lTempBaseBoxName.set_text( baseName )\
\
        lTempVisible := true\
        if baseIncrease < baseInc and darvasTop > priorLevel\
            lTempMove.set_textcolor( halfBaseColor )\
        else\
            lTempMove.set_textcolor( completeBaseColor )\
\
