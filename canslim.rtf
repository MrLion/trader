// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
//\
// M A R K E T _ E X P O S U R E _ I N D I C A T O R  \
//\
// Market direction is in many ways the most important factor in the CAN SLIM system.\
//\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
var expInfo                 = table.new(position = position.top_left, columns = 3, rows = 8, border_width = 1, force_overlay = true)\
var expValue                = 0.0\
var frc                     = color.black\
var marketCycleUp           = false\
var marketCycleAgeUp        = 0\
var marketCycleAgeDown      = 0\
\
// CALCULATE\
\
[ indexBarIndex, indexLow, indexClose, indexClose1, indexVolume, indexVolume1, indexMA20, indexMA50, indexMA100, indexMA150, indexMA200, index52WHigh, indexPerf ] =\
      request.security( indexSymbol, "1D", [ bar_index, low, close, close[1], volume, volume[1], ta.sma(close,20), ta.sma(close,50), ta.sma(close,100), ta.sma(close,150),\
                        ta.sma(close,200), ta.highest(yearBars),\
                        (close - open[perfDays]) / open[perfDays] * 100 ] )\
\
[indexAccDays,indexDistDays] =\
      request.security( indexSymbol, "1D", getLastAccDistDays(25) )\
\
\
case1                       = indexMA20 > indexMA200 \
case2                       = indexMA20 < indexMA50 ? 10 : 0\
caseDT1                     = indexMA20 < indexMA200 ? 10 : 0\
caseDT2                     = indexMA50 < indexMA200 ? 10 : 0\
caseDT3                     = indexMA100 < indexMA200 ? 10 : 0\
barsCloseLowerThanEma20     = ta.barssince(indexClose<indexMA20)\
barsCloseLowerThanEma50     = ta.barssince(indexClose<indexMA50)\
barsCloseLowerThanEma100    = ta.barssince(indexClose<indexMA100)\
barsCloseLowerThanEma150    = ta.barssince(indexClose<indexMA150)\
barsCloseLowerThanEma200    = ta.barssince(indexClose<indexMA200)\
\
caseAD                      = 0\
\
if indexDistDays > indexAccDays\
    caseAD := (indexDistDays-indexAccDays)*5\
\
if case1\
    if indexClose > indexMA20 and barsCloseLowerThanEma20 > 4\
        expValue := 100\
    else if indexClose > indexMA50 and barsCloseLowerThanEma50 > 4\
        expValue := 90\
    else if indexClose > indexMA100 and barsCloseLowerThanEma100 > 4\
        expValue := 80\
    else if indexClose > indexMA150 and barsCloseLowerThanEma150 > 4\
        expValue := 70\
    else \
        expValue := 20\
    expValue -= (case2 + caseDT1 + caseDT2 + caseDT3)\
else \
    if indexClose > indexMA200 and barsCloseLowerThanEma200 > 4\
        expValue := 100\
    else if indexClose > indexMA150 and barsCloseLowerThanEma150 > 4\
        expValue := 80\
    else if indexClose > indexMA100 and barsCloseLowerThanEma100 > 4\
        expValue := 60\
    else if indexClose > indexMA50 and barsCloseLowerThanEma50 > 4\
        expValue := 40\
    else if indexClose > indexMA20 and barsCloseLowerThanEma20 > 4\
        expValue := 20\
    else\
        expValue := 0\
    expValue -= (2*caseDT1 + 2*caseDT2 + caseDT3)\
\
expValue    -= caseAD\
expValue    := expValue < 0 ? 0 : expValue\
if expValue != 0 or expValue[1] != 0\
    expValue    := (expValue + expValue[1]) / 2\
\
if marketCycleUp\
    marketCycleUp := expValue < 30 ? false : true\
else\
    marketCycleUp := expValue > 75 ? true : false\
\
if marketCycleUp\
    marketCycleAgeUp += 1\
    marketCycleAgeDown := 0\
else\
    marketCycleAgeUp := 0\
    marketCycleAgeDown += 1\
\
// DISPLAY\
\
if isIndex\
    last25IndexAccDaysStr   = str.tostring( indexAccDays, "#")\
    last25IndexDistDaysStr  = str.tostring( indexDistDays, "#")\
\
    expStr = str.format( "\{0,number,#\}%", expValue )\
    table.merge_cells( expInfo, 0, 3, 2, 3 )\
\
    table.cell( expInfo, column = 0, row = 0, text = "" )\
    table.cell( expInfo, column = 0, row = 1, text = "" )\
    table.cell( expInfo, column = 0, row = 2, text = "" )\
\
    if isIndex\
        table.cell(table_id = expInfo, column = 0, row = 3, text = "Stock Market Exposure " + expStr, text_color =  getValueTextColor(expValue,30, 50), bgcolor = tValueBkgnd )\
        table.cell(table_id = expInfo, column = 0, row = 4, text = "Accumulation\\nDays", text_color = color.white, bgcolor = color.blue )\
        table.cell(table_id = expInfo, column = 1, row = 4, text = "Distribution\\nDays", text_color = color.white, bgcolor = color.blue )\
        table.cell(table_id = expInfo, column = 2, row = 4, text = "Market Cylce", text_color = color.white, bgcolor = color.blue )\
\
        table.cell(table_id = expInfo, column = 0, row = 5, text = last25IndexAccDaysStr, text_color = color.white, bgcolor = color.blue )\
        table.cell(table_id = expInfo, column = 1, row = 5, text = last25IndexDistDaysStr, text_color = color.white, bgcolor = color.blue )\
        mcVal = str.format( "\{0\} \{1\} \{2\}", marketCycleUp ? "Up" : "Down", marketCycleUp ? marketCycleAgeUp : marketCycleAgeDown,\
                             timeframe.isweekly ? "Weeks" : timeframe.isdaily ? "Days" : timeframe.main_period )\
        table.cell(table_id = expInfo, column = 2, row = 5, text = mcVal, text_color = color.white, bgcolor = color.blue )\
\
// Only to fix scale\
hline( 100, "Fixed scale Max", noColor, editable = false )\
hline( 0,   "Fixed scale Min", noColor, editable = false )\
\
plot( (isIndex?expValue:na), "Exposure", color = getValueTextColor(expValue,30,50), precision = 0, format = format.percent, editable=false,\
      display=display.all-display.status_line )\
\
distDays = distDayA.size() \
if timeframe.isdaily and isIndex and distDays > 0 and showDistDays and barstate.islast\
    for adi = 0 to distDays-1\
        DistDay d = distDayA.get(adi) \
        label.new( d.barIndex, d.barHigh, "\uc0\u9660 ", force_overlay=true, textcolor=distDaysColor, style = label.style_none, size = size.normal, tooltip = "Distribution Day"  )\
\
\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
//\
// R E L A T I V E _ S T R E N G T H _ A N D _ R A T I N G  ( I B D _ S T Y L E )\
//\
// IBD's Base RS calculation uses a weighted formula where the most recent quarter is weighted the double of others.\
// Strength Factor = 0.4 * ROC(C, 63) + 0.2 * ROC(C, 126) + 0.2 * ROC(C, 189) + 0.2 * ROC(C,252)\
// The Standardized RS Rating value was reverse engineered with the help of some other different custom formulas.\
// Ranges from 1 (worst) to 99 (best), indicating that a stock is outperforming a certain percentage of all stocks.\
//\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
var showYears               = 10 \
var rslStart                = timestamp( yearNow-showYears, monthNow, dayNow, 0, 0 )\
var rslActive               = false\
var float monLowestRS       = na\
var float weeLowestRS       = na\
var float pMonthLowestRS    = na\
var float lRS1              = 0\
var float lRS2              = 0\
\
if not rslActive and time  >= rslStart or isReplay\
    rslActive := not isIndex\
\
var labelRS                 = label.new( bar_index, na, force_overlay=true, color=showRSL ? rsLabelBkgnd : noColor, textcolor=rsLabelText, size = size.small,\
                                         tooltip = "Relative Strength Rating"  )\
\
int Q1                      = timeframe.isdaily ? 63  : 13\
int Q2                      = timeframe.isdaily ? 126 : 26\
int Q3                      = timeframe.isdaily ? 189 : 39\
int Q4                      = timeframe.isdaily ? 252 : 52\
var stdRelStrength          = 0.0\
var chartRelStrength        = 0.0\
var graphicMultiplier       = 0.0\
\
// CALCULATE\
\
[cNW,cQ1,cQ2,cQ3,cQ4]       = request.security( indexSymbol, "1D", [close, close[Q1], close[Q2], close[Q3], close[Q4] ] ) \
\
sFYQ1                       = 4*(cNW-cQ1)/cQ1*100\
sFYQ2                       = 2*(cNW-cQ2)/cQ2*100\
sFYQ3                       = 2*(cNW-cQ3)/cQ3*100\
sFYQ4                       = 2*(cNW-cQ4)/cQ4*100\
\
[sFSQ1,sFSQ2,sFSQ3,sFSQ4]   = request.security( syminfo.tickerid, "1D", [4*(close-close[Q1])/close[Q1]*100, 2*(close-close[Q2])/close[Q2]*100,\
                                                2*(close-close[Q3])/close[Q3]*100, 2*(close-close[Q4])/close[Q4]*100 ] )   \
\
SF                          = sFSQ1 + sFSQ2 + sFSQ3 + sFSQ4\
SY                          = sFYQ1 + sFYQ2 + sFYQ3 + sFYQ4\
\
if rslActive\
    if SF > 100\
        stdRelStrength  := 75 + (SF-SY) / SF * 25\
        if stdRelStrength >= 90 and stdRelStrength < 96\
            stdRelStrength -= 1\
        else if stdRelStrength > 85 and stdRelStrength < 90\
            stdRelStrength -= 2\
    else if SF > 60\
        stdRelStrength  := 75 + (SF-SY) / SF * 30\
    else if SF > 10\
        stdRelStrength := 42 + SF/20*5\
    else if SF > 0\
        stdRelStrength := 39 + SF/20*5\
    else if SF > -50\
        gc = math.log( math.abs(50/(50-SF)) ) \
        stdRelStrength  := gc * 10 + 34\
    else\
        gc = math.log( math.abs(745/SF) ) \
        stdRelStrength  := gc * 10\
\
    // Last Adjustment\
    if stdRelStrength < 20 or (stdRelStrength > 75 and stdRelStrength < 86)\
        stdRelStrength -= 2\
\
    // Ensure we are between 1 and 99\
    stdRelStrength      := math.max( 1, math.min( 99, stdRelStrength ) )\
    mu                  = timeframe.isweekly ?  0.55 : 0.60\
    graphicMultiplier   := close / stdRelStrength * mu\
\
if newWEEK\
    lRS2 := lRS1\
    lRS1 := math.floor( weeLowestRS )\
    weeLowestRS := na\
\
weeLowestRS := na(weeLowestRS) ? stdRelStrength : stdRelStrength < weeLowestRS ? stdRelStrength : weeLowestRS\
\
    // save monthly lowest RS\
if newMONTH\
    rankRSM3 := rankRSM2\
    pMonthLowestRS := math.floor( monLowestRS )\
    rankRSM2 := pMonthLowestRS\
    monLowestRS := na\
\
\
monLowestRS := na(monLowestRS) ? stdRelStrength : stdRelStrength < monLowestRS ? stdRelStrength : monLowestRS\
// Calculate Rank Data\
rankRSThisM := monLowestRS\
wtNow = math.min(1,dayofmonth/28)\
wtM1  = 1-wtNow\
rankRSM1C   := rankRSThisM*wtNow + rankRSM2*wtM1\
rankTotRS   := ( rankRSM1C*3 + rankRSM2*2 + rankRSM3 ) / 6\
\
// DISPLAY \
\
if rslActive and showRSL\
    chartRelStrength  := stdRelStrength * graphicMultiplier\
    rsStr             = na(stdRelStrength) ? "" : str.format( "\{0,number,#\}", stdRelStrength )\
    labelRS.set_text( rsStr )\
    labelRS.set_xy( bar_index, chartRelStrength )\
    labelRS.set_style( label.style_label_left )\
    labelRS.set_text_formatting( text.format_bold )\
    labelRS.set_text_font_family( font.family_monospace )\
\
plot( (rslActive and showRSL) ? chartRelStrength : na, color=color.gray, title="Relative Strength Line", force_overlay = true,\
      display = display.all-display.status_line )\
\
// REL STRENGTH AT PIVOT POINTS /////////////////////////////////////////\
\
var pivotLen = 21\
var float lastHighPivot = na\
var float lastLowPivot = na\
\
pivotH  = ta.pivothigh( pivotLen, pivotLen )\
pivotL  = ta.pivotlow( pivotLen, pivotLen )\
\
if rslActive\
    if showRSSwingsH and not na(pivotH)\
        rsIndex = bar_index-bar_index[pivotLen]\
        if not na( stdRelStrength[rsIndex] )\
            lText = str.format( "\{0,number,#\}", stdRelStrength[rsIndex] )\
            label.new( bar_index[pivotLen], pivotH*1.05, lText, force_overlay=true, color = rsLabelBkgnd, textcolor=rsLabelText, size = size.small, style = label.style_label_down,\
                       tooltip = "RS Rating", text_formatting= text.format_bold, text_font_family=font.family_monospace )\
        lastHighPivot := pivotH\
    if showRSSwingsL and  not na(pivotL)\
        rsIndex = bar_index-bar_index[pivotLen]\
        if not na( stdRelStrength[rsIndex] )\
            lText = str.format( "\{0,number,#\}", stdRelStrength[rsIndex] )\
            label.new( bar_index[pivotLen], pivotL*0.95, lText, force_overlay=true, color = rsLabelBkgnd, textcolor=rsLabelText, size = size.small, style = label.style_label_up,\
                       tooltip = "RS Rating", text_formatting= text.format_bold, text_font_family=font.family_monospace )\
        lastLowPivot := pivotL\
\
\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
// \
// T R E N D _ D U R A T I O N\
//\
// Calculate the number of days since MA100 is above MA200 along with performances\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
var valueTrend          = 0.0\
\
bool ma50_above_ma200           = ma50 > ma200\
[stockPerf,stockPerf1M,stockPerf3M, stockPerf6M, trendDuration, volSma50, dayVol ] = \
                              request.security( syminfo.tickerid, "1D",\
                              [ (close - open[perfDays]) / open[perfDays] * 100 ,\
                                (close - open[perfDays1M]) / open[perfDays1M] * 100,\
                                (close - open[perfDays3M]) / open[perfDays3M] * 100,\
                                (close - open[perfDays6M]) / open[perfDays6M] * 100,\
                                ta.barssince( not ma50_above_ma200 ),\
                                ta.sma( volume, 50 ),\
                                volume ] )\
\
var float pma = 0.0\
var float pmb = 0.0\
var float pmc = 0.0\
if bar_index > perfDays\
    pma := math.max( 0, math.min( 99, (ma50 - ma50[perfDays])   / ma50[perfDays]   * 100 )  )\
if bar_index > perfDays6M\
    pmb := math.max( 0, math.min( 99, (ma50 - ma50[perfDays6M]) / ma50[perfDays6M] * 100 )  )\
if bar_index > perfDays3M\
    pmc := math.max( 0, math.min( 99, (ma50 - ma50[perfDays3M]) / ma50[perfDays3M] * 100 )  )\
rankTotPerf = math.max( 0, math.min( 99, (pma*2+pmb*1+pmc*1)/4 ) )\
valueTrend := rankTotPerf\
\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
//\
// M O M E N T U M _ I N D I C A T O R ( C U S T O M )\
// \
// Counts the numer of 1 Month high in a month.\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
new1MHigh           = false\
new1MHighM          = false\
var newWeek         = true\
var nhCount         = 0\
var newHigh     = false\
var lastM1MH    = 0\
var lastMW      = 0\
var prevMW      = 0\
var prevWeek    = 0\
var lastWeek    = 0\
\
\
// Save previous week/month data\
if newWEEK \
    newWeek     := true\
    prevMW      := lastMW\
    lastM1MH    += lastMW\
    lastMW      := 0\
    prevWeek    := lastWeek\
    lastWeek    := weekofyear\
if newMONTH\
    rankMM3 := rankMM2\
    rankMM2 := lastM1MH\
    newHigh := false\
    //prevM1MH := lastM1MH\
    nhCount := 0\
    lastM1MH := 0\
\
\
// CALCULATE\
OneMHBars = ta.highestbars( 21 ) == 0 \
\
// Any time count\
if OneMHBars\
    new1MHighM := true\
    nhCount += 1\
    lastMW += 1\
\
\
// Calculate Rank Data\
rankMThisM := lastM1MH\
wtMNow      = math.min(1,dayofmonth/28)\
wtMM1       = 1-wtMNow\
rankMM1C   := rankMThisM*wtMNow + rankMM2*wtMM1\
totM1w = math.min(99,rankMM1C/8 * 99) * 3\
totM2w = math.min(99,rankMM2 /8 * 99) * 2\
totM3w = math.min(99,rankMM3 /8 * 99) * 1\
rankTotM   := ( totM1w + totM2w + totM3w ) / 6\
\
// DISPLAY\
\
if nhCount >= 8 and not newHigh and showMom\
    newHigh := true\
    lNH = label.new( bar_index, high*1.05, "\uc0\u8663 ", force_overlay=true, color=noColor, style=label.style_label_down, text_formatting=text.format_bold,\
                    textcolor=momColor, tooltip = "Strong Momentum", size=size.normal  )\
// weekly\
if showMomW and newWeek and new1MHighM and (showMom==false or showMom==true and nhCount <7)\
    newWeek := false\
    wcs = "\uc0\u9900 "\
    lNH = label.new( bar_index, high*1.05, wcs, force_overlay=true, color=noColor, style=label.style_label_down, text_formatting=text.format_bold,\
                    textcolor=momColor, tooltip = "Weekly Momentum", size=size.normal  )\
\
\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
//\
// GROWTH CONSISTENCY\
//\
//\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
var growthConsistency   = 0.0\
var currentConsistency  = 0.0\
const int period        = 42    // Window is 42 days (2 months)\
const float threshold   = 25    // Increases if perf > 25%\
const float maxValue    = 24    // Max is 24 = 6 months (Minimum value is 0)\
\
// CALCULATE\
if bar_index > (2*period)\
    if newWEEK\
        grp = (close[1]-open[period+1]) / open[period+1] * 100\
        inc = grp >= threshold ? 1 : -1\
        growthConsistency := math.min( maxValue, math.max( 0, growthConsistency + inc ) )\
    grp = (close-open[period]) / open[period] * 100\
    inc = grp >= threshold ? 1 : -1\
    currentConsistency := math.min( maxValue, math.max( 0, growthConsistency + inc ) )\
\
\
\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
// C A N S L I M  _ T A B L E\
//\
