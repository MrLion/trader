insertBox( val, min, accept, left, top, right, bttm ) =>\
    txt = na(val)  ? "0" : str.format( "\{0,number,#\}", val )\
    nzT = normalizeString( txt, nz )\
    tc  = getValueTextColor(val,min,accept)\
    createDataBox( left, top, right, bttm, nzT, tc )\
\
\
updateBox( bx, left, right, txt, clr ) =>\
    bx.set_left( left )\
    bx.set_right( right )\
    bx.set_text( txt )\
    bx.set_text_color( clr )\
