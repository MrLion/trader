// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
//\
// F O L L O W - T H R O U G H _ D A Y _ I N D I C A T O R\
//\
// Follow Through day occurs when there is 1% or more day gain in S&P 500 or Nasdaq Composite with volume greater than previous day.\
// This must occur at least 4 days from the potential bottom of that rally.\
// Not every follow through day works but it's a great signal that you must take to eventually change mind from Bearish to Bullish.\
// The indicator is optimized in order to find three kinds of FT days. Minor, Intermediate and Major according to the magnitude of the FT day compared\
// to last 52 week high in the S&P 500. Everything below 5% is ignored, Minor FT day appear afer a pullback between 5%-10%,\
// Intermediate ones appear on corrections of 10%-20% and Major FT days appear in bear markets when the correction is more that 20%\
//\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
string shapeStyle       = shape.diamond\
\
enum ftdStates\
    ftdIdle             = "Idle baseState"\
    ftdSeek             = "Searching for Lowest day"\
    ftdDayFound         = "Found Follow Through Day"\
\
var ftdStates ftdState  = ftdStates.ftdIdle\
var ftdLow              = 0.0\
var ftdLowBar           = 0\
var ftdBarCountSinceLow = 0\
\
// Retrieve all needed Index Data\
indexBar                = indexBarIndex\
ftdMin                  = false\
ftdInt                  = false\
ftdMajor                = false\
\
// idle baseState, search for a new low below MA100\
if ftdState == ftdStates.ftdIdle\
    if indexLow < indexMA100\
        ftdState    := ftdStates.ftdSeek\
        ftdLow      := indexLow\
        ftdLowBar   := indexBar \
\
// Seek baseState, get lowest low or catch qualified day \
if ftdState == ftdStates.ftdSeek\
    if indexLow < ftdLow\
        ftdLow := indexLow\
        ftdLowBar := indexBar\
    else\
        ftdBarCountSinceLow := indexBar-ftdLowBar\
        if ftdBarCountSinceLow > 4\
            if (indexClose-indexClose1)/indexClose1*100 > 1 and indexVolume > indexVolume1\
                diff = math.abs( (index52WHigh-indexClose)/index52WHigh*100 )\
                if diff > 5 and diff < 10\
                    ftdMin := true\
                else if diff > 10 and diff < 20\
                    ftdInt := true\
                else if diff > 20\
                    ftdMajor := true\
                ftdState := ftdStates.ftdDayFound\
\
// Day found baseState, signal day on chart and wait either near the low or we are above EMA200 to start searching again.\
if ftdState == ftdStates.ftdDayFound\
    if indexLow > indexMA200 or math.abs(indexLow-ftdLow)/ftdLow*100 < 1\
        ftdState := ftdStates.ftdIdle\
\
\
if ftdMin and showMinFTD\
    label.new( bar_index, low*0.9, "\uc0\u9670 ", xloc = xloc.bar_index, yloc = yloc.price, color = noColor, textcolor = color.gray, style=label.style_label_up,\
               tooltip = "Minor Follow-Through Day", force_overlay = true )\
if ftdInt and showIntFTD\
    label.new( bar_index, low*0.9, "\uc0\u9670 ", xloc = xloc.bar_index, yloc = yloc.price, color = noColor, textcolor = color.silver, style=label.style_label_up,\
               tooltip = "Intermediate Follow-Through Day", force_overlay = true )\
if ftdMajor and showMajFTD\
    label.new( bar_index, low*0.9, "\uc0\u9670 ", xloc = xloc.bar_index, yloc = yloc.price, color = noColor, textcolor = color.white, style=label.style_label_up,\
               tooltip = "Major Follow-Through Day", force_overlay = true )\
\
\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
//\
// A T R _ C H A N N E L _ I N D I C A T O R\
//\
// Determines first a conditional median price of the day/week:\
// If the close is abobe 50% of high-low, the median price is calculated with low+(high-low)/2 (conservative approach), otherwise we use closing price.\
// We add/subtract the average ATR multiplied by a user multiplier to calculate higher and lower bands\
// The lower band is treated as a support line, meaning that if new ATR low band is lower than previous value, the previous value is used instead so it can only go up or stay flat.\
// Upper band is calculated in a standard way.\
// When the bands are broken on a closing basis, we stop drawing and wait atrPeriod bars to start drawing again.\
// \uc0\u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019  \u10019 \
atrBandSource       = close > (low+(high-low)/2) ? low+(high-low)/2 : close\
atrActive           = false\
atrStart            = timestamp( yearNow-atrYearsBack, monthNow, dayNow, 0, 0 ) // yearNow already calcd\
const int atrPeriod = 3\
\
if time >= atrStart or isReplay\
    atrActive := not isIndex\
\
var rangeHigh       = 0.0\
var rangeLow        = 0.0\
var rangeLow5       = 0.0\
var rangeLow6       = 0.0\
var rangeLow7       = 0.0\
var consecH         = 0\
var consecL         = 0\
bool lowOn          = true\
bool HighOn         = true\
lowOn              := false\
HighOn             := false\
var lowBColor       = #F23645\
var labelATR        = label.new( na, na, force_overlay=true, color=showATRLowBand ? lowBColor : noColor, textcolor=showATRLowBand?rsLabelText:noColor, size = size.small,\
                                 tooltip = "ATR multiplier Line"  )\
var lineWrap        = line.new( na, na, na, na, xloc.bar_index, extend.none, color=showATRLowBand ? lowBColor : noColor, style = line.style_solid, force_overlay = true )\
\
rangeHigh := atrBandSource + avgAtr * atrMultiplier\
if not na(rangeHigh[1])\
    rangeHigh := atrBandSource + avgAtr * atrMultiplier < rangeHigh[1] ? atrBandSource + avgAtr * atrMultiplier : rangeHigh[1]\
    if close[1] >= rangeHigh\
        rangeHigh := high\
        HighOn := false\
        consecH := 0\
    else\
        consecH += 1\
        if consecH >= atrPeriod\
            HighOn := true\
\
rangeLow    := atrBandSource - avgAtr * atrMultiplier \
\
if not na(rangeLow[1])\
    rangeLow := rangeLow > rangeLow[1] ? rangeLow : rangeLow[1]\
    if close[1] <= rangeLow\
        rangeLow := low[1]\
        lowOn := false\
        consecL := 0\
    else\
        consecL += 1\
        if consecL >= atrPeriod\
            lowOn := true\
\
rangeLow5   := atrBandSource - avgAtr * 5 //3 \
rangeLow6   := atrBandSource - avgAtr * 6 \
rangeLow7   := atrBandSource - avgAtr * 7 \
\
if not na(rangeLow5[1])\
    rangeLow5 := rangeLow5 > rangeLow5[1] ? rangeLow5 : rangeLow5[1]\
    if close[1] <= rangeLow5\
        rangeLow5 := low[1]\
if not na(rangeLow6[1])\
    rangeLow6 := rangeLow6 > rangeLow6[1] ? rangeLow6 : rangeLow6[1]\
    if close[1] <= rangeLow6\
        rangeLow6 := low[1]\
if not na(rangeLow7[1])\
    rangeLow7 := rangeLow7 > rangeLow7[1] ? rangeLow7 : rangeLow7[1]\
    if close[1] <= rangeLow7\
        rangeLow7 := low[1]\
\
plot( (atrActive and showATRUpBand)?rangeHigh:na, color=HighOn?color.blue:noColor, linewidth=1, style=plot.style_stepline, title="ATR Upper Band",\
      force_overlay=true, display = display.all-display.status_line )\
plot( (atrActive and showATRLowBand)?rangeLow:na, color=lowOn?lowBColor:noColor, linewidth=1, style=plot.style_stepline, title="ATR Lower Band",\
      force_overlay=true, display = display.all-display.status_line )\
\
if showATRLowBand\
    lineWrap.set_xy1( bar_index, rangeLow )\
    lineWrap.set_xy2( bar_index+5, rangeLow )\
    atrLabelText = str.tostring(atrMultiplier)+"x"\
    labelATR.set_text( atrLabelText )\
    labelATR.set_xy( bar_index+5, rangeLow )\
    labelATR.set_style( label.style_label_left )\
    labelATR.set_text_formatting( text.format_bold )\
    labelATR.set_text_font_family( font.family_monospace )\
    \
\
