var newWeekNum          = 0\
var pastWeekNum         = 0\
var int pastWeekBoxLeft = na\
var int newWeekBoxLeft  = bar_index\
\
var pastMonthNum        = 0\
var newMonthNum         = 0\
var int pastMonthLeft   = na\
var int NewMonthLeft    = na\
\
var prevWI1             = 0\
var prevWI2             = 0\
var prevWI3             = 0\
\
