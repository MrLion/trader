# Trader Environment Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env to git!

# ============================================================================
# ALPACA API — Paper account (required for paper trading)
# Get keys from: https://app.alpaca.markets/paper
# ============================================================================
ALPACA_PAPER_API_KEY=your_paper_api_key_here
ALPACA_PAPER_SECRET_KEY=your_paper_secret_key_here

# ============================================================================
# ALPACA API — Live account (required only for live trading)
# Get keys from: https://app.alpaca.markets
# ============================================================================
ALPACA_LIVE_API_KEY=your_live_api_key_here
ALPACA_LIVE_SECRET_KEY=your_live_secret_key_here

# ============================================================================
# ALPACA — Optional settings
# ============================================================================
# Historical bars to fetch per ticker (default: 365)
# ALPACA_HISTORICAL_DAYS=365

# ============================================================================
# FMP API (Required for earnings calendar filter)
# Get key from: https://financialmodelingprep.com/developer/docs
# Paid plan recommended: 300 req/min, no daily cap
# ============================================================================
FMP_API_KEY=your_fmp_api_key_here

# ============================================================================
# Telegram Bot (Optional — for report delivery)
# Create a bot: https://t.me/BotFather
# ============================================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=-4872065090

# ============================================================================
# MC Stock Charts (Optional — for mcstock_scraper.py)
# Get credentials from: https://www.mcstockcharts.com/members/
# ============================================================================
MCSTOCK_USER=your_username_here
MCSTOCK_PASS=your_password_here
